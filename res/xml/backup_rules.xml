<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude
            domain="database"
            path="bugle_db" />
        <exclude
            domain="sharedpref"
            path="bugle_widgets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="bugle_db" />
        <exclude
            domain="sharedpref"
            path="bugle_widgets.xml" />
    </device-transfer>
</data-extraction-rules>
